#!/usr/bin/env bash

# Observe a remote Elixir node over an SSH tunnel.

set -euo pipefail

if [ $# -lt 2 ] || [ $# -gt 3 ]; then
    cat >&2 <<EOF
Usage: ${0##*/} <remote host> <app name> [cookie]

Observe a remote elixir node using ssh port forwarding.
The cookie is prompted for when omitted, which keeps it out of shell history.
EOF
    exit 2
fi

remote_host=$1
remote_name=$2
cookie=${3-}

if [ -z "$cookie" ]; then
    read -rsp 'Erlang cookie: ' cookie
    echo
fi

# Query once; the previous version ran epmd twice and stripped every non-digit
# from the line, which glued digits from the node name onto the port number.
epmd_out=$(ssh "$remote_host" 'epmd -names')

epmd_port=$(printf '%s\n' "$epmd_out" | sed -n 's/^epmd: up and running on port \([0-9]\{1,\}\).*/\1/p')
node_port=$(printf '%s\n' "$epmd_out" | sed -n "s/^name ${remote_name} at port \([0-9]\{1,\}\)\$/\1/p")

if [ -z "$epmd_port" ] || [ -z "$node_port" ]; then
    echo "Could not determine epmd/node ports for '$remote_name' on $remote_host:" >&2
    printf '%s\n' "$epmd_out" >&2
    exit 1
fi

printf 'Creating tunnel for ports: [epmd=%s] [node=%s]\n' "$epmd_port" "$node_port"

# Forward to 127.0.0.1: the destination is resolved on the remote side, where
# an ssh-config alias for $remote_host would not resolve.
ssh -f -o ExitOnForwardFailure=yes \
    -L "${epmd_port}:127.0.0.1:${epmd_port}" \
    -L "${node_port}:127.0.0.1:${node_port}" \
    "$remote_host" \
    sleep 5

printf 'Connecting with node [%s] \n\n' "$remote_name"

# Pass the cookie through a 0600 file so it never appears in the process table.
cookie_home=$(mktemp -d)
trap 'rm -rf "$cookie_home"' EXIT
(umask 077 && printf '%s' "$cookie" >"$cookie_home/.erlang.cookie")

HOME="$cookie_home" iex \
    --name "debug@127.0.0.1" \
    -e "Node.connect(:\"$remote_name@127.0.0.1\"); :observer.start()"
