#!/usr/bin/env bash

# Install the latest MaterialFox theme into the default Firefox profile.

set -euo pipefail

profiles_dir="$HOME/Library/Application Support/Firefox/Profiles"
download_url="https://github.com/edelvarden/material-fox-updated/releases/latest/download/chrome.zip"

profile=""
count=0
while IFS= read -r dir; do
    profile="$dir"
    count=$((count + 1))
done < <(find "$profiles_dir" -mindepth 1 -maxdepth 1 -type d)

if [ "$count" -ne 1 ]; then
    echo "Error: expected exactly one Firefox profile, found $count" >&2
    exit 1
fi

# A fixed /tmp path would let any local user pre-create the target and get
# their own files installed as Firefox chrome code.
tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT

curl -fsSL -o "$tmp/chrome.zip" "$download_url"
unzip -q "$tmp/chrome.zip" -d "$tmp"

if [ ! -d "$tmp/chrome" ]; then
    echo "Error: archive contained no chrome/ directory" >&2
    exit 1
fi

# Swap in the new directory only once it is known good, so a failed download
# can't leave the profile with no chrome/ at all.
rm -rf "$profile/chrome.bak"
if [ -d "$profile/chrome" ]; then
    mv "$profile/chrome" "$profile/chrome.bak"
fi
mv "$tmp/chrome" "$profile/chrome"

echo "MaterialFox updated successfully"
