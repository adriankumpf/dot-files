#!/usr/bin/env bash

# Fix staged changes up into an earlier commit: creates a `fixup!` commit and
# immediately rebases it into place. Other fixup!/squash! commits in the
# rebased range are squashed too, as `--autosquash` normally does.

set -euo pipefail

usage() {
    cat <<EOF
Usage: ${0##*/} [-e] <commit-ref>

Fix the currently staged changes up into <commit-ref>.

Options:
  -e  Edit the commit list before rebasing
  -h  Show this message
EOF
}

edit=false
while getopts "eh" opt; do
    case "$opt" in
        e) edit=true ;;
        h)
            usage
            exit 0
            ;;
        *)
            usage >&2
            exit 2
            ;;
    esac
done
shift $((OPTIND - 1))

if [ $# -ne 1 ]; then
    usage >&2
    exit 2
fi

# Resolve before committing: a relative ref such as HEAD~2 would point at a
# different commit once the fixup commit sits on top.
target=$(git rev-parse --verify "$1^{commit}")

if git rev-parse --verify --quiet "$target^" >/dev/null; then
    onto=("$target^")
else
    onto=(--root)
fi

git commit --fixup="$target" --no-verify

# --autostash keeps unstaged work out of the rebase and restores it afterwards,
# including when the rebase stops on a conflict.
if "$edit"; then
    git rebase --interactive --autosquash --autostash "${onto[@]}"
else
    GIT_SEQUENCE_EDITOR=true git rebase --interactive --autosquash --autostash "${onto[@]}"
fi
