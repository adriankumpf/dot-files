#!/usr/bin/env bash

# usage: find ~/Music/ -name '*.flac' -exec ~/bin/flac2mp3 {} +

set -euo pipefail

tag() { metaflac --show-tag="$1" "$2" | sed 's/^[^=]*=//'; }

for f in "$@"; do
    [[ "$f" != *.flac ]] && continue

    # Without pipefail a mid-stream flac failure would go unnoticed, because
    # lame still exits 0 and leaves a silently truncated mp3 behind.
    flac --decode --stdout "$f" |
        lame --preset insane --add-id3v2 \
            --tt "$(tag title "$f")" \
            --ta "$(tag artist "$f")" \
            --tl "$(tag album "$f")" \
            --ty "$(tag date "$f")" \
            --tn "$(tag tracknumber "$f")" \
            --tg "$(tag genre "$f")" \
            - "${f%.flac}.mp3"
done
