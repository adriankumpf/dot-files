#!/usr/bin/env bash

# Listen to SomaFM in the terminal.

set -euo pipefail

usage() {
    cat <<'EOF'
somafm - Listen to SomaFM in your terminal

USAGE:
    somafm [channel]

ARGS:
    <channel>    The channel to listen to; picked interactively if omitted
EOF
}

case "${1-}" in
    -h | --help)
        usage
        exit 0
        ;;
esac

for cmd in jq mpv fzf curl; do
    if ! command -v "$cmd" >/dev/null; then
        echo "somafm: $cmd is required but not installed" >&2
        exit 1
    fi
done

channel="${1-}"

channels=$(curl -fsS -H 'Accept: application/json' https://somafm.com/channels.json)

if [ -z "$channel" ]; then
    channel=$(
        jq -r '.channels
               | sort_by(.listeners | tonumber)
               | reverse
               | .[]
               | .id + " | " + .listeners + " listeners | " + .description' <<<"$channels" |
            fzf --layout=reverse | awk '{print $1}'
    )
    clear
    [ -n "$channel" ] || exit 130
fi

# --arg keeps the channel name out of the jq program text.
playlist=$(jq -r --arg id "$channel" \
    '.channels[]
     | select(.id == $id)
     | .playlists
     | map(select(.quality == "highest"))
     | first
     | .url' <<<"$channels")

if [ -z "$playlist" ] || [ "$playlist" = null ]; then
    echo "somafm: unknown channel '$channel'" >&2
    exit 1
fi

# Print each announced track with a local timestamp.
mpv --no-config "$playlist" 2>/dev/null |
    awk '/title/ { $1 = ""; sub(/^ +/, ""); print strftime("%H:%M:%S"), "|", $0 }'
